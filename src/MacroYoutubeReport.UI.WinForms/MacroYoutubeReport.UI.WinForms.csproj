<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MacroYoutubeReport.Core\MacroYoutubeReport.Core.csproj" />
    <ProjectReference Include="..\MacroYoutubeReport.Driver.Android\MacroYoutubeReport.Driver.Android.csproj" />
    <ProjectReference Include="..\MacroYoutubeReport.Driver.Chrome\MacroYoutubeReport.Driver.Chrome.csproj" />
    <ProjectReference Include="..\MacroYoutubeReport.Scheduler\MacroYoutubeReport.Scheduler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Configs\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
